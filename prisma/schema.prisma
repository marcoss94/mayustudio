generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  ADMIN
  SUPERADMIN
}

enum StyleType {
  STANDARD       // Precio único (Fine Art, Minimalista)
  SETS_AND_TIERS // Múltiples sets con Standard/Premium (Cake Smash)
  SEASONAL       // Temporada limitada (Día de las Madres, Navidad)
}

enum ReservationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  IN_PROCESS
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// ─── Auth.js Required Models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          UserRole  @default(CLIENT)

  accounts     Account[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// ─── Estilos (la estética fotográfica) ───────────────────────────────────────

model Style {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  type             StyleType
  description      String?   @db.Text
  shortDescription String?   @db.VarChar(200)
  coverImage       String?
  highlights       String[]
  badge            String?   @db.VarChar(30)
  label            String?   @db.VarChar(50)  // ej: "Celebración Vibrante", "Legado Artístico"
  duration         Int?      // minutos (para estilos con duración fija)
  price            Decimal?  @db.Decimal(10, 2) // solo para STANDARD y SEASONAL
  // Tier details (solo para SETS_AND_TIERS)
  tierStandardHighlights String[]
  tierPremiumHighlights  String[]
  tierStandardDuration   Int?
  tierPremiumDuration    Int?
  tierStandardTagline    String? @db.VarChar(80)
  tierPremiumTagline     String? @db.VarChar(80)
  isActive         Boolean   @default(true)
  isVisible        Boolean   @default(true)
  displayOrder     Int       @default(0)
  seasonStart      DateTime? // solo SEASONAL
  seasonEnd        DateTime? // solo SEASONAL

  sets         StyleSet[]
  extras       StyleExtra[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([type])
  @@index([isActive, isVisible])
  @@index([displayOrder])
}

// Sets temáticos (solo para estilos tipo SETS_AND_TIERS, ej: Cake Smash)

model StyleSet {
  id            String  @id @default(cuid())
  styleId       String
  name          String
  slug          String
  description   String? @db.Text
  coverImage    String?
  standardPrice Decimal @db.Decimal(10, 2)
  premiumPrice  Decimal @db.Decimal(10, 2)
  isCustom      Boolean @default(false) // true = set personalizado (precio fijo, texto libre)
  customPrice   Decimal? @db.Decimal(10, 2) // precio fijo del set personalizado (sin tiers)
  isActive      Boolean @default(true)
  displayOrder  Int     @default(0)

  style        Style         @relation(fields: [styleId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([styleId, slug])
  @@index([styleId, isActive])
  @@index([displayOrder])
}

// Extras opcionales (ej: para Minimalista)

model StyleExtra {
  id       String  @id @default(cuid())
  styleId  String
  name     String
  price    Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([styleId, isActive])
}

// ─── Experiencia Completa (config global) ────────────────────────────────────

model ExperienciaCompletaConfig {
  id            String  @id @default(cuid())
  description   String? @db.Text
  coverImage    String?
  images        String[]
  highlights    String[]
  eventPrice3h  Decimal @db.Decimal(10, 2)
  eventPrice4h  Decimal @db.Decimal(10, 2)
  comboDiscount Decimal @db.Decimal(10, 2) // monto fijo de descuento
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Reservas ────────────────────────────────────────────────────────────────

model Reservation {
  id                   String            @id @default(cuid())
  userId               String
  status               ReservationStatus @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime
  childName            String?
  childAge             Int?              // meses
  notes                String?           @db.Text
  totalAmount          Decimal           @db.Decimal(10, 2)
  expiresAt            DateTime?         // now() + 10min para PENDING_PAYMENT

  // Qué se reservó
  styleId              String
  styleSetId           String?           // null si el estilo no tiene sets
  tier                 String?           // "standard" | "premium" | null (para custom/standard type)
  customSetDescription String?  @db.Text // solo cuando styleSet.isCustom = true

  // Experiencia completa (null si no aplica)
  isExperienciaCompleta Boolean  @default(false)
  eventDurationHours    Int?     // 3 o 4
  eventPrice            Decimal? @db.Decimal(10, 2)
  comboDiscount         Decimal? @db.Decimal(10, 2)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  style    Style     @relation(fields: [styleId], references: [id])
  styleSet StyleSet? @relation(fields: [styleSetId], references: [id])
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([styleId])
  @@index([status])
  @@index([startsAt])
  @@index([expiresAt])
}

// ─── Pagos ───────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  externalId    String?
  provider      String        @default("mercadopago")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("ARS")
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  rawPayload    Json?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalId])
  @@index([status])
  @@index([provider])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  externalId  String?
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  processedAt DateTime?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([provider, status])
  @@index([externalId])
  @@index([createdAt])
}

// ─── Galería ─────────────────────────────────────────────────────────────────

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  caption   String?
  order     Int     @default(0)
  isVisible Boolean @default(true)
  styleSlug String? @db.VarChar(100) // filtrar por estilo
  setSlug   String? @db.VarChar(100) // filtrar por set dentro de un estilo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, order])
  @@index([styleSlug])
  @@index([isVisible, styleSlug])
  @@index([styleSlug, setSlug, isVisible, order])
}
