generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  ADMIN
  SUPERADMIN
}

enum ReservationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  IN_PROCESS
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// ─── Auth.js Required Models ─────────────────────────────────────────────────
// Estos modelos son requeridos por @auth/prisma-adapter con JWT strategy.
// El modelo Session NO se incluye porque usamos JWT (no database sessions).

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null para OAuth users
  phone         String?
  role          UserRole  @default(CLIENT)

  accounts     Account[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  order       Int     @default(0)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?  @db.VarChar(200) // Resumen para cards (Phase 1)
  price            Decimal  @db.Decimal(10, 2)
  duration         Int      // minutos
  isActive         Boolean  @default(true)
  isVisible        Boolean  @default(true)
  images           String[] // URLs de S3
  coverImage       String?             // URL imagen principal (Phase 1)
  highlights       String[]            // Ej: ["Torta artesanal incluida", "20 fotos editadas"] (Phase 1)
  badge            String?  @db.VarChar(30) // Ej: "Más popular", "Nuevo", "Estacional" (Phase 1)
  minChildAge      Int?                // Edad mínima en meses; 0 = recién nacido (Phase 1)
  maxChildAge      Int?                // Edad máxima en meses; null = sin límite (Phase 1)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isVisible])
}

model Reservation {
  id          String            @id @default(cuid())
  userId      String
  serviceId   String
  status      ReservationStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  childName   String?
  childAge    Int?
  notes       String?           @db.Text
  totalAmount Decimal           @db.Decimal(10, 2)
  expiresAt   DateTime?         // now() + 10min para PENDING_PAYMENT

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([startsAt])
  @@index([expiresAt])
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String        @unique
  externalId     String?       // Mercado Pago payment ID
  provider       String        @default("mercadopago")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("ARS")
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  rawPayload     Json?         // Full MP webhook payload

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  webhookEvents WebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalId])
  @@index([status])
  @@index([provider])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String             // "mercadopago"
  externalId  String?            // ID del evento en el proveedor
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  processedAt DateTime?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([provider, status])
  @@index([externalId])
  @@index([createdAt])
}

model GalleryImage {
  id          String  @id @default(cuid())
  url         String
  alt         String
  caption     String?
  order       Int     @default(0)
  isVisible   Boolean @default(true)
  serviceSlug String? @db.VarChar(100) // Soft ref para filtrar por servicio (Phase 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, order])
  @@index([serviceSlug])
  @@index([isVisible, serviceSlug])
}
